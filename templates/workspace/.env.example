# Workspace .env — gitignored. Loaded by scripts/scheduler.bat and scripts/telegram-bot.bat
# before they launch PHP so skills can read these via getenv() / $env:NAME.
#
# Copy this file to .env in your workspace directory and fill in real values.

# Telegram bot credentials (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database credentials referenced from TOOLS.md / CLAUDE.md / skill scripts.
# The names are arbitrary — match what your TOOLS.md says.
# EXAMPLE_DB_USER=
# EXAMPLE_DB_PASS=
