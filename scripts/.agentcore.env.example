# Copy this file to .agentcore.env (no .example suffix) in this scripts\ directory.
# scheduler.bat and telegram-bot.bat source it before launching PHP so the values
# are available without having to edit the .bat files or the scheduled-task XML.
#
# Use forward slashes for paths — they work in cmd.exe, PowerShell, and bash, and
# avoid backslash escaping in shell sources.

# Full path to your workspace directory. The .bat scripts load <workspace>/.env
# from here so skills inherit your Telegram token and DB credentials.
AGENTCORE_WORKSPACE=C:/path/to/your/workspace

# Optional: full path to php.exe. Defaults to "php" (must be on PATH).
# AGENTCORE_PHP_BIN=C:/PHP/php.exe
